# Copy to .env and fill in. .env is gitignored; never commit a real key.

# Which writer to use: "claude" (needs ANTHROPIC_API_KEY) or "mock" (free, deterministic, lower quality).
GE_LLM=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# low | medium | high
LLM_EFFORT=medium
# Parallel copy-writing calls
LLM_CONCURRENCY=4

# Where the landing link in every UTM points
UTM_BASE_URL=https://www.incubrix.com/

# Folders (relative to the project root)
GE_DATA_DIR=data
GE_CONTENT_DIR=content
GE_OUT_DIR=out
GE_LOG_DIR=logs

# ffmpeg / ffprobe binaries if they are not on PATH
FFMPEG=ffmpeg
FFPROBE=ffprobe

# faster-whisper model for audio/video inputs without a transcript (tiny | base | small | medium)
WHISPER_MODEL=small

# Fault injection for the recovery demo, e.g. llm_timeout@write:3 (fails the 3rd copy call once per run)
GE_FAULT=
